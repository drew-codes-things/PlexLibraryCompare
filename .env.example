PLEX_TOKEN=
PLEX_SERVER_NAME=

# Point these at any two Plex show libraries you want to compare -
# they don't have to be anime, e.g. "TV Shows" / "TV Shows - High".
LOW_LIBRARY_NAME=Anime Shows
HIGH_LIBRARY_NAME=Anime Shows - High

WEB_USERNAME=
WEB_PASSWORD=
BIND_HOST=127.0.0.1
PORT=5001
ALLOW_INSECURE=false

# Only set this to true if the app is served over HTTPS (e.g. behind a
# TLS-terminating reverse proxy) - otherwise the browser will silently
# drop the session cookie and CSRF-protected requests (Scan Now) will fail.
SESSION_COOKIE_SECURE=false

# Optional: override where the SQLite database file is written.
# Defaults to plex_compare.db next to db.py.
# PLEX_COMPARE_DB_PATH=
